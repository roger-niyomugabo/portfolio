# Contact form delivery (SMTP). Copy to .env or .env.local and fill in.
# Defaults suit Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as EMAIL_PASSWORD.
API_SENDER_EMAIL=you@gmail.com
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx

# Optional. Where messages arrive; defaults to the email in data/profile.ts.
# CONTACT_TO_EMAIL=you@gmail.com
# Optional. Another SMTP provider.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
